+// WMI 在某些机器上根本拉不起 PowerShell（helper 还没写 ready 就被回收，broker
+// 只能看到 child_exit_code=unknown）。此时改用计划任务启动同一份 helper，并每分钟
+// 重试：helper 被控制台关闭/系统回收（0xC000013A）时，下一轮会重新拉起并完成换包。
+function scheduleHandoffViaTask({ exe, asar, token, script, statePath, timeoutSeconds = 10800, hours = 3 }) {
+  const taskName = `dsh-purge-handoff-${token.slice(0, 8)}`;
+  const runner = path.join(os.tmpdir(), `dsh-purge-handoff-${token}.run.ps1`);
+  const psq = (value) => "'" + String(value).replaceAll("'", "''") + "'";
+  const body = [
+    "$ErrorActionPreference='Stop'",
+    `& ${psq(script)} -ExePath ${psq(exe)} -AsarPath ${psq(asar)} -StatePath ${psq(statePath)} -Token ${psq(token)} -TimeoutSeconds ${timeoutSeconds}`,
+    // helper 结束（换包完成 / 失效 / 超时）后自删任务，不遗留计划任务
+    `try { $s = Get-Content -LiteralPath ${psq(statePath)} -Raw | ConvertFrom-Json } catch { $s = $null }`,
+    `if (-not $s -or $s.token -ne ${psq(token)} -or $s.phase -in @('complete','already_unsealed','expired','failed')) { schtasks /delete /tn ${psq(taskName)} /f 2>$null | Out-Null }`,
+  ].join("\r\n");
+  fs.writeFileSync(runner, body, "utf8");
+  const powershell = path.join(process.env.SystemRoot || "C:\\Windows", "System32", "WindowsPowerShell", "v1.0", "powershell.exe");
+  // 每分钟重试一次：helper 被控制台关闭/系统回收时（本机复现为 0xC000013A）下一轮自动补上。
+  const register = [
+    "$ErrorActionPreference='Stop'",
+    `$runner = ${psq(runner)}`,
+    `$argument = '-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + $runner + '"'`,
+    `$action = New-ScheduledTaskAction -Execute ${psq(powershell)} -Argument $argument`,
+    `$trigger = New-ScheduledTaskTrigger -Once -At ((Get-Date).AddYears(1)) -RepetitionInterval (New-TimeSpan -Minutes 1) -RepetitionDuration (New-TimeSpan -Hours ${hours})`,
+    "$settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew -StartWhenAvailable",
+    "$principal = New-ScheduledTaskPrincipal -UserId $env:USERNAME -LogonType Interactive -RunLevel Limited",
+    `Register-ScheduledTask -TaskName ${psq(taskName)} -Action $action -Trigger $trigger -Settings $settings -Principal $principal -Force | Out-Null`,
+    `Start-ScheduledTask -TaskName ${psq(taskName)}`,
+  ].join("\r\n");
+  execFileSync(powershell, ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", register], { stdio: "ignore" });
+  return { taskName, script: runner };
+}
